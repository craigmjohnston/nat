# --- plumbing ---------------------------------------------------------------


class Fail(Exception):
    """An error nat should show: exit code + one stderr line."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    path = os.path.join(base, "nat-source-demo")
    os.makedirs(path, exist_ok=True)
    return path


def load_comments():
    path = os.path.join(state_dir(), "comments.json")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        raise Fail(f"demo: can't read {path}: {e}")
    return data if isinstance(data, dict) else {}


def save_comments(data):
    path = os.path.join(state_dir(), "comments.json")
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def card(cid):
    c = CARDS.get(cid)
    if c is None:
        raise Fail(f"demo: no card {cid!r}")
    return c


def badge(c):
    name, color = PROJECTS[c["project"]]
    return {"text": c["project"], "color": color, "title": name}


def row(cid):
    c = CARDS[cid]
    return {
        "id": cid,
        "title": c["title"],
        "external_url": f"https://example.com/demo/card/{cid}",
        "badges": [badge(c)],
        "meta": f"{c['estimate']} pt" if c["estimate"] == 1 else f"{c['estimate']} pts",
        "menu": CARD_MENU,
    }


# --- methods ----------------------------------------------------------------


def describe(req):
    return {
        "protocol": PROTOCOL,
        "name": "demo",
        "title": "Demo source",
        "tag": "DM",
        "icon_symbol": "rectangle.on.rectangle.angled",
        "container_noun": "card",
        "task_noun": "task",
        "menu": [REFRESH],
    }


def sidebar(req):
    expand = req.get("expand") or []
    if not isinstance(expand, list):
        raise Fail("demo: expand must be a list of group ids")
    done = {"id": "done", "label": "Done", "count": DONE_COUNT, "lazy": True, "menu": [REFRESH]}
    if "done" in expand:
        done["containers"] = [row("d1"), row("d2")]
    return {
        "groups": [
            {"id": "doing", "label": "Doing", "count": 2, "containers": [row("c1"), row("c2")]},
            {
                "id": "ready",
                "label": "Ready",
                "count": 1,
                "children": [
                    # Segments are saved filters over the same cards, so one card
                    # may sit in more than one of them.
                    {"id": "ready/mine", "label": "Mine", "count": 1, "menu": SEGMENT_MENU,
                     "containers": [row("c3")]},
                    {"id": "ready/board", "label": "Board", "count": 1, "menu": SEGMENT_MENU,
                     "containers": [row("c3")]},
                ],
            },
            done,
        ]
    }


def container(req):
    cid = req.get("id")
    if not isinstance(cid, str) or not cid:
        raise Fail("demo: container needs an id")
    c = card(cid)
    name, color = PROJECTS[c["project"]]
    comments = list(c["comments"]) + load_comments().get(cid, [])
    return {
        "id": cid,
        "title": c["title"],
        "external_url": f"https://example.com/demo/card/{cid}",
        "facts": [
            {"label": "id", "value": f"dm-{cid}"},
            {"label": "project", "value": f"{c['project']} · {name}", "color": color},
            {"label": "state", "value": c["state"]},
            {"label": "type", "value": c["type"]},
            {"label": "estimate", "value": str(c["estimate"])},
            {"label": "epic", "value": c["epic"]},
            {"label": "labels", "value": ", ".join(c["labels"])},
            {"label": "owner", "value": c["owner"]},
            {"label": "requester", "value": c["requester"]},
        ],
        "sections": [
            {"id": "story", "title": "Story", "kind": "prose", "body": c["story"]},
            {"id": "comments", "title": "Comments", "kind": "comments",
             "comments": comments, "composer": COMPOSER},
            {"id": "links", "title": "Links", "kind": "links", "links": c["links"]},
        ],
        "menu": CARD_MENU,
        "task_note": TASK_NOTE_FMT.format(id=cid),
    }


def action(req):
    aid = req.get("action")
    target = req.get("target") or {}
    if not isinstance(target, dict):
        raise Fail("demo: target must be an object")
    text = req.get("input") or ""
    group, cid = target.get("group"), target.get("container")

    if aid == "refresh":
        return {"message": "Refreshed"}
    if aid == "comment":
        if not cid:
            raise Fail("demo: comment needs a card")
        card(cid)
        if not text.strip():
            raise Fail("demo: comment needs some text")
        data = load_comments()
        data.setdefault(cid, []).append({
            "by": os.environ.get("USER") or "you",
            "when": time.strftime("%d %b %H:%M"),
            "text": text.strip(),
        })
        save_comments(data)
        return {"message": f"Commented on dm-{cid}"}
    if aid == "follow":
        if not cid:
            raise Fail("demo: follow needs a card")
        card(cid)
        return {"message": f"Following dm-{cid} (demo: nothing changed)"}
    if aid in ("rename", "owner", "remove"):
        if group not in ("ready/mine", "ready/board"):
            raise Fail(f"demo: {aid} needs a segment (got {group!r})")
        if aid == "rename":
            if not text.strip():
                raise Fail("demo: rename needs a name")
            return {"message": f"Would rename {group} to {text.strip()!r} (demo: nothing changed)"}
        if aid == "owner":
            if text not in SEGMENT_MENU[1]["options"]:
                raise Fail(f"demo: owner must be one of any, me, unassigned (got {text!r})")
            return {"message": f"Would filter {group} to owner {text} (demo: nothing changed)"}
        return {"message": f"Would remove {group} (demo: nothing changed)"}
    raise Fail(f"demo: unknown action {aid!r}")


def event(req):
    name = req.get("event")
    task = req.get("task")
    if not isinstance(task, dict) or not isinstance(name, str):
        raise Fail("demo: event needs an event name and a task")
    # An event this plugin doesn't know is logged and ignored, never refused:
    # a later protocol may add some. Duplicates and out-of-order delivery are
    # fine too; the log just records what arrived.
    line = {
        "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "project": (req.get("project") or {}).get("id"),
        "container": req.get("container"),
        "event": name,
        "known": name in EVENTS,
        "task": task,
    }
    with open(os.path.join(state_dir(), "events.log"), "a", encoding="utf-8") as f:
        f.write(json.dumps(line) + "\n")
    return {}


def setup(req):
    # The demo needs no credential, so its describe lists no setup fields and
    # every setup request is refused.
    raise Fail("demo: nothing to set up")


METHODS = {
    "describe": describe,
    "sidebar": sidebar,
    "container": container,
    "action": action,
    "event": event,
    "setup": setup,
}


def main(argv):
    if len(argv) != 2:
        print("usage: nat-source-demo <describe|sidebar|container|action|event|setup> < request.json",
              file=sys.stderr)
        return 2
    method = METHODS.get(argv[1])
    if method is None:
        print(f"demo: unknown method {argv[1]!r}", file=sys.stderr)
        return 2
    try:
        req = json.loads(sys.stdin.read())
        if not isinstance(req, dict):
            raise ValueError("not a JSON object")
    except ValueError as e:
        print(f"demo: request is not one JSON object: {e}", file=sys.stderr)
        return 1
    project = req.get("project")
    # `nat source-list` describes with an empty project, and setup is sent
    # one too (no project is in question), so only the other methods need an
    # id.
    if not isinstance(project, dict) or (argv[1] not in ("describe", "setup") and not project.get("id")):
        print("demo: request has no project", file=sys.stderr)
        return 1
    try:
        resp = method(req)
    except Fail as e:
        print(str(e), file=sys.stderr)
        return e.code
    except OSError as e:
        print(f"demo: {e}", file=sys.stderr)
        return 1
    json.dump(resp, sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
